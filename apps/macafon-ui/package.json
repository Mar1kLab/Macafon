{
  "name": "macafon-ui",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
